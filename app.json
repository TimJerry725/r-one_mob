{
  "expo": {
    "name": "r-one-mobV2",
    "slug": "r-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.timjerry725.rone",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.timjerry725.rone",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBvfhnvDhgCQL4gUELzIYkcHorD2YFMTTg"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow r-one to use your location to confirm you are at the work site."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow r-one to access your camera to scan asset QR codes."
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyBvfhnvDhgCQL4gUELzIYkcHorD2YFMTTg",
          "androidGoogleMapsApiKey": "AIzaSyBvfhnvDhgCQL4gUELzIYkcHorD2YFMTTg"
        }
      ],
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "c178cec5-4850-4baa-93dd-7cf566d17e6a"
      }
    }
  }
}
